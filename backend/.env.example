# Copy to backend/.env. Leave OPENAI_API_KEY empty to run without Live mode.
# The key stays on the server and is never sent to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Limits that protect your API bill. Defaults are shown.
MAX_INPUT_CHARS=500
MAX_OUTPUT_TOKENS=220
RATE_LIMIT_PER_MINUTE=6
DAILY_REQUEST_CAP=200
MAX_CONCURRENT_STREAMS=4
REQUEST_TIMEOUT_SECONDS=45

# Browsers allowed to call this API (comma separated).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: force a tokenizer encoding (for example o200k_base).
TOKENIZER_ENCODING=
